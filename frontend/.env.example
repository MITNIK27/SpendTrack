VITE_API_BASE_URL=http://localhost:8005/api

# Firebase web app config (Console > Project settings > General > Your apps > SDK setup
# and configuration). These are public by design — safe to expose in the frontend bundle,
# same as any Firebase web app. The real access-control boundary is the backend's
# verified-token + @infobeans.com domain check, not these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
