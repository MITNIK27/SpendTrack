# Postgres connection used by SQLAlchemy/Alembic.
# Primary: Supabase project's Session pooler string (Settings > Database > Connection
# string > "Session pooler" mode, port 5432). The plain "Direct connection" host
# (db.<project-ref>.supabase.co) is IPv6-only unless you've paid for Supabase's IPv4
# add-on, so it fails to resolve on most home/office networks — use the Session pooler
# host instead (aws-0-<region>.pooler.supabase.com), which is IPv4-compatible and, unlike
# the Transaction pooler (port 6543), behaves like a normal connection for Alembic's DDL.
# Note the username also changes to "postgres.<project-ref>" for the pooler. Add the
# `+psycopg` driver prefix:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Alternative: local Docker Postgres (`docker compose up -d`) for fully offline work:
DATABASE_URL=postgresql+psycopg://spend:spend@localhost:5434/marketing_spend

# CORS — the Vite dev server origin. Vite has no fixed port here (other local
# projects also use 5173/9005), so it lands on the first free port from 5173
# upward — list the likely candidates.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

ENV=local

# Local attachment storage (Phase 12 swaps this for Firebase Storage)
UPLOADS_DIR=./uploads
