<?xml version="1.0" encoding="utf-8"?>
<!--
  Lets IIS host the FastAPI backend via the httpPlatformHandler module: IIS spawns and
  supervises the uvicorn process (start/stop/recycle/logging) and proxies requests to it
  on the port IIS assigns via %HTTP_PLATFORM_PORT%.

  Requires the httpPlatformHandler module installed on the server (see docs/deployment.md § 2),
  and the application pool set to "No Managed Code".

  Update processPath/workingDirectory below if the deployment path differs from C:\spend\backend.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="C:\spend\backend\.venv\Scripts\python.exe"
                   arguments="-m uvicorn app.main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT%"
                   workingDirectory="C:\spend\backend"
                   startupTimeLimit="30"
                   startupRetryCount="3"
                   stdoutLogEnabled="true"
                   stdoutLogFile="C:\spend\backend\logs\stdout"
                   processesPerApplication="1">
    </httpPlatform>
  </system.webServer>
</configuration>
